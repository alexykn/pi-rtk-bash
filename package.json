{
  "name": "pi-rtk-bash",
  "version": "0.1.1",
  "type": "module",
  "description": "RTK-backed rtk_bash tool for Pi one-shot shell commands.",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "rtk",
    "bash",
    "shell",
    "token-saving",
    "coding-agent"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check",
    "test": "node --import tsx --test tests/preview.test.mjs",
    "test:rtk": "node --import tsx --test tests/rtk.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^26.6.3",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexykn/pi-rtk-bash.git"
  },
  "bugs": {
    "url": "https://github.com/alexykn/pi-rtk-bash/issues"
  },
  "homepage": "https://github.com/alexykn/pi-rtk-bash#readme",
  "dependencies": {
    "pi-code-previews": "^0.1.36"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
